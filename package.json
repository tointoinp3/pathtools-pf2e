{
  "name": "pathtools-2e",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web": "vite build",
    "lint": "oxlint",
    "test": "node --import ./scripts/test-alias.mjs --test \"src/**/*.test.ts\"",
    "test:watch": "node --import ./scripts/test-alias.mjs --test --watch \"src/**/*.test.ts\"",
    "check:pt": "node scripts/check-pt-coverage.mjs",
    "check:bestiary": "node scripts/assert-family-asides.mjs && node scripts/assert-creature-lore.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
